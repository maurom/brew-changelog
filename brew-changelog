#!/bin/sh
#
# brew-changelog
# Open the changelog or release notes for Homebrew formulas and casks in a browser.
#
# Copyright (c) 2026 Mauro A. Meloni <github.com/maurom>
#
# shellcheck disable=SC2317

set -e

VERSION="20260914.1"
PRINT_ONLY=0

get_script_path() {
  target="${1:-$0}"
  case "${target}" in
    */*) echo "${target}" ;;
    *)   command -v "${target}" 2>/dev/null || echo "${target}" ;;
  esac
}

SCRIPT=$(get_script_path "$0")

show_help() {
  echo "brew-changelog ${VERSION}"
  echo
  echo "Usage: brew changelog [options] formula|cask ..."
  echo "     ./brew-changelog [options] formula|cask ..."
  echo
  echo "Open the changelog or release notes for Homebrew formulas and casks in a browser."
  echo
  echo "Options:"
  echo "  -u, --url       Show the changelog URL instead of opening a browser"
  echo "  -h, --help      Show this help message"
  echo "  --version       Show version"
  echo
  echo "Bugs can be reported on GitHub: https://github.com/maurom/brew-changelog"
  echo
  exit "${1:-0}"
}

open_url() {
  target="$1"
  if command -v open >/dev/null 2>&1; then
    open "${target}"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "${target}"
  elif [ -n "${BROWSER}" ]; then
    "${BROWSER}" "${target}"
  else
    echo "${target}"
  fi
}

PACKAGES=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      show_help 0
      ;;
    --version)
      echo "brew-changelog ${VERSION}"
      exit 0
      ;;
    -u|--url)
      PRINT_ONLY=1
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      echo "Usage: brew changelog [-u|--url] formula|cask ..." >&2
      exit 1
      ;;
    *)
      PACKAGES="${PACKAGES} $1"
      shift
      ;;
  esac
done

PACKAGES="${PACKAGES# }"
test -z "${PACKAGES}" && show_help 1

EXIT_CODE=0

for PACKAGE in ${PACKAGES}; do
  URL=""

  # Check internal dataset
  if [ -z "${URL}" ] && [ -r "${SCRIPT}" ]; then
    URL=$(awk '/^__DATA__$/,0' "${SCRIPT}" 2>/dev/null | grep -m1 "^${PACKAGE%@*}," | cut -d, -f2 || true)
  fi

  # Fallback: extract homepage from formula/cask info and deduce releases URL
  if [ -z "${URL}" ]; then
    HOMEPAGE=$(brew info --json=v2 "${PACKAGE}" 2>/dev/null | grep -E -m1 'https://(github\.com|gitlab\.com|codeberg\.org)' | cut -d'"' -f4 || true)
    case "${HOMEPAGE}" in
      *github.com/*/*|*gitlab.com/*/*|*codeberg.org/*/*)
        REPO=$(echo "${HOMEPAGE}" | cut -d/ -f-5 | sed 's#\.git$##')
        case "${HOMEPAGE}" in
          *github.com/google/fonts*) URL= ;;
          *gitlab.com/*) URL="${REPO}/-/releases" ;;
          *)             URL="${REPO}/releases" ;;
        esac
        ;;
    esac
  fi

  if [ -z "${URL}" ]; then
    echo "No changelog url listed for ${PACKAGE}" >&2
    brew home "${PACKAGE}" 2>/dev/null || EXIT_CODE=$?
  elif [ "${PRINT_ONLY}" -eq 1 ]; then
    echo "${URL}"
  else
    echo "Opening ${URL}"
    open_url "${URL}"
  fi
done

exit "${EXIT_CODE}"

